PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# DATABASE CONFIGURATION
# MongoDB Connection URI (Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/novise_db?retryWrites=true&w=majority

# AUTHENTICATION & SECURITY
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=30d

# DEFAULT SUPER ADMIN INITIAL CREDENTIALS
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@novise.in
ADMIN_PASSWORD=your_secure_admin_password

# RAZORPAY PAYMENT GATEWAY
# Test or Live keys (Simulated fallback active if using placeholder keys)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# COURIER & LOGISTICS (Manual Tracking via India Post / Courier Portals)
DEFAULT_COURIER_NAME="India Post"
DEFAULT_TRACKING_PORTAL="https://www.indiapost.gov.in/"

# TRANSACTIONAL EMAIL (NODEMAILER / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Novis Herbal Care <care@novise.in>"

# FILE STORAGE
UPLOAD_PATH=uploads

# CLOUDINARY MEDIA ASSETS & COMPLAINT VIDEO STORAGE
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=NOVISE_HERBAL

